# AFTERIMAGE — Environment Variables (Example)
# Copy to .env and fill in your values. Never commit .env.
#
# Default mode: REAL PROVIDER (OpenRouter). Judges supply their own API key.
# AFTERIMAGE_TEST_MODEL_DOUBLE is intentionally absent (disabled).
# Optional TEST MODEL (deterministic double, no live model HTTP) is documented
# in README §5 — enable only for isolated demo graphs, never as the default.

# OpenRouter API Key (free tier: https://openrouter.ai/keys)
# Get a key at https://openrouter.ai/keys — no credit card required
# Required for live agent investigation and normal startup validation.
OPENROUTER_API_KEY=your_openrouter_key_here

# Model to use. Options:
# - openrouter/free (router that picks free tool-calling models)
# - nvidia/nemotron-3-super-120b-a12b:free
# - openai/gpt-oss-20b:free
# - google/gemma-4-26b-a4b-it:free
# - google/gemma-4-31b-it:free
# - nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# FalkorDB connection for application (uses default port 6379)
# localhost refers to the machine running Docker/FalkorDB (your PC for local setup).
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=afterimage_workspace

# Workspace ID (single workspace for MVP)
WORKSPACE_ID=default

# Backend server port
# http://localhost:$PORT/ is local to this machine only (not a public URL).
PORT=3001

# OPTIONAL — leave unset for real-provider mode (default).
# AFTERIMAGE_TEST_MODEL_DOUBLE=1