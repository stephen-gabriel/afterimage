# AFTERIMAGE — Environment Variables (Example)
# Copy to .env and fill in your values. Never commit .env.

# OpenRouter API Key (free tier: https://openrouter.ai/keys)
# Get a key at https://openrouter.ai/keys — no credit card required
OPENROUTER_API_KEY=your_openrouter_key_here

# Model to use. Options:
# - openrouter/free (router that picks free tool-calling models)
# - nvidia/nemotron-3-super-120b-a12b:free
# - openai/gpt-oss-20b:free
# - google/gemma-4-26b-a4b-it:free
# - google/gemma-4-31b-it:free
# - nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# FalkorDB connection for application (uses default port 6379)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=afterimage_workspace

# Workspace ID (single workspace for MVP)
WORKSPACE_ID=default

# Backend server port
PORT=3001